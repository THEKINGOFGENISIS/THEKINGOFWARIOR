            (LowGraphics and "ON" or "OFF"),
            90
        )

    lag.MouseButton1Click:Connect(function()

        LowGraphics = not LowGraphics

        lag.Text =
            "FIX LAG : " ..
            (LowGraphics and "ON" or "OFF")

        for _, v in ipairs(
            workspace:GetDescendants()
        ) do

            if v:IsA("ParticleEmitter")
            or v:IsA("Trail")
            or v:IsA("Beam") then

                v.Enabled =
                    not LowGraphics

            elseif v:IsA("BasePart")
            and LowGraphics then

                if not OldGraphics[v] then
                    OldGraphics[v] = v.Material
                end

                v.Material =
                    Enum.Material.SmoothPlastic

            elseif v:IsA("BasePart")
            and not LowGraphics
            and OldGraphics[v] then

                v.Material =
                    OldGraphics[v]
            end
        end
    end)
end

