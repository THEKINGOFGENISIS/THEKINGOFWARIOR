--// DRAG
local dragging = false
local start
local startPos

Header.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
    or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = true
        start = input.Position
        startPos = Main.Position
    end
end)

UIS.InputChanged:Connect(function(input)

    if dragging
    and (
        input.UserInputType ==
            Enum.UserInputType.MouseMovement
        or input.UserInputType ==
            Enum.UserInputType.Touch
    ) then

        local delta =
            input.Position - start

        Main.Position =
            UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
    end
end)

UIS.InputEnded:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1
    or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = false
    end
end)

--// FOLLOW + VIEW LOOP
RunService.RenderStepped:Connect(function()

    -- Auto target
    if AutoTarget then

        if not Target
        or not Target.Parent
        or not Target.Character
        or not Target.Character:FindFirstChild(
            "HumanoidRootPart"
        ) then

            Target = FindNearest()
        end
    end

    -- Follow
    if Following and Target then

        local root =
            P.Character
            and P.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local targetRoot =
            Target.Character
            and Target.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if root and targetRoot then

            root.CFrame =
                targetRoot.CFrame *
                CFrame.new(
                    0,
                    0,
                    FollowDistance
                )
        end
    end

    -- View target
    if ViewTarget and Target then

        local targetCharacter =
            Target.Character

        local humanoid =
            targetCharacter
            and targetCharacter:FindFirstChildOfClass(
                "Humanoid"
            )

        if humanoid then
            Camera.CameraSubject = humanoid
        end
    end
end)

--// AFK TIMER
task.spawn(function()

    while task.wait(1) do

        if AntiAFK then
            AFKTime += 1
        end
    end
end)

--// TOOL LOOP
task.spawn(function()

    while task.wait(AutoInterval) do

        if AutoPunch or AutoClick then

            local character = P.Character

            local tool =
                character
                and character:FindFirstChildOfClass(
                    "Tool"
                )

            if tool then
                pcall(function()
                    tool:Activate()
                end)
            end
        end
    end
end)

