local function FindPlayer(name)
    name = string.lower(name or "")

    if name == "" then
        return nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if string.lower(player.Name) == name
        or string.lower(player.DisplayName) == name then
            return player
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if string.sub(
            string.lower(player.Name),
            1,
            #name
        ) == name then
            return player
        end
    end

    return nil
end

local function FindNearest()
    local character = P.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local nearest
    local distance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= P then

            local char = player.Character
            local targetRoot =
                char and char:FindFirstChild("HumanoidRootPart")

            if targetRoot then

                local d =
                    (root.Position - targetRoot.Position).Magnitude

                if d < distance then
                    distance = d
                    nearest = player
                end
            end
        end
    end

    return nearest
end

--// FOLLOW
local function FollowPage()
    Clear()

    TitlePage("Follow Options")

    local box = Box("", 40)
    box.PlaceholderText = "Target Name"

    local dist = Box(tostring(FollowDistance), 85)

    local follow = Button(
        "FOLLOW : " ..
        (Following and "ON" or "OFF"),
        130
    )

    local auto = Button(
        "AUTO TARGET : " ..
        (AutoTarget and "ON" or "OFF"),
        180
    )

    local status = Instance.new("TextLabel", Content)

    status.Size = UDim2.new(1, 0, 0, 30)
    status.Position = UDim2.fromOffset(0, 235)
    status.BackgroundTransparency = 1
    status.Text =
        Target and "Target: " .. Target.Name
        or "No Target"

    status.TextColor3 =
        Color3.fromRGB(180, 140, 150)

    status.TextSize = 12
    status.TextXAlignment =
        Enum.TextXAlignment.Left

    follow.MouseButton1Click:Connect(function()

        if Following then

            Following = false
            Target = nil

            follow.Text = "FOLLOW : OFF"
            status.Text = "Stopped"

        else

            local player =
                FindPlayer(box.Text)

            if player then

                Target = player
                Following = true

                follow.Text = "FOLLOW : ON"
                status.Text =
                    "Following: " ..
                    player.Name

            else
                status.Text = "Target Not Found"
            end
        end
    end)

    auto.MouseButton1Click:Connect(function()

        AutoTarget = not AutoTarget

        auto.Text =
            "AUTO TARGET : " ..
            (AutoTarget and "ON" or "OFF")

        if AutoTarget then
            Following = true
            status.Text =
                "Finding nearest player..."
        else
            Following = false
            Target = nil
            status.Text =
                "Auto Target stopped"
        end
    end)

    dist.FocusLost:Connect(function()

        FollowDistance =
            math.clamp(
                tonumber(dist.Text) or 3,
                1,
                50
            )

        dist.Text =
            tostring(FollowDistance)
    end)
end

