local Protection={
 AntiFling={Enabled=true},
 PositionLock={Enabled=false,Position=nil,Rotation=nil}
}

local function enableAntiFling()
 local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
 if not Protection.AntiFling.Enabled or not root then return end
 local bv=root:FindFirstChild("SilenceAntiFling")
 if not bv then
  bv=Instance.new("BodyVelocity")
  bv.Name="SilenceAntiFling"
  bv.MaxForce=Vector3.new(100000,0,100000)
  bv.P=1250
  bv.Parent=root
 end
 bv.Velocity=Vector3.zero
end

local function disableAntiFling()
 local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
 local bv=root and root:FindFirstChild("SilenceAntiFling")
 if bv then bv:Destroy() end
end

MainTab:Toggle("Anti Fling",true,function(s)
 Protection.AntiFling.Enabled=s
 if s then enableAntiFling() else disableAntiFling() end
end)

local function lockPosition()
 local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
 if not Protection.PositionLock.Enabled or not Protection.PositionLock.Position or not root then return end
 if not root.Anchored then root.Anchored=true end
 root.CFrame=CFrame.new(Protection.PositionLock.Position)*Protection.PositionLock.Rotation
 root.AssemblyLinearVelocity=Vector3.zero
 root.AssemblyAngularVelocity=Vector3.zero
end

local function unlockPosition()
 local root=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
 if root then
  root.Anchored=false
  root.AssemblyLinearVelocity=Vector3.zero
  root.AssemblyAngularVelocity=Vector3.zero
 end
 Protection.PositionLock.Position=nil
 Protection.PositionLock.Rotation=nil
end

MainTab:Toggle("Lock Position",false,function(s)
