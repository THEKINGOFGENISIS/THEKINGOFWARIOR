local function formatNumber(n)
 n=tonumber(n) or 0
 if n>=1e18 then return string.format("%.1fqi",n/1e18)
 elseif n>=1e15 then return string.format("%.1fqa",n/1e15)
 elseif n>=1e12 then return string.format("%.1ft",n/1e12)
 elseif n>=1e9 then return string.format("%.1fb",n/1e9)
 elseif n>=1e6 then return string.format("%.1fm",n/1e6)
 elseif n>=1e3 then return string.format("%.1fk",n/1e3)
 else return tostring(n) end
end

local function formatCommas(n)
 local s=tostring(math.floor(tonumber(n) or 0))
 while true do
  local changed
  s,changed=s:gsub("^(-?%d+)(%d%d%d)","%1.%2")
  if changed==0 then break end
 end
 return s
end

local function greeting()
 local h=os.date("*t").hour
 if h>=6 and h<12 then return "Good Morning "..Player.DisplayName
 elseif h>=12 and h<13 then return "Good Noon "..Player.DisplayName
 elseif h>=13 and h<19 then return "Good Afternoon "..Player.DisplayName
 elseif h>=19 and h<22 then return "Good Evening "..Player.DisplayName
 else return "Good Night "..Player.DisplayName end
end

