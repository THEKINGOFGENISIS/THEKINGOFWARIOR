 advanced.edmg.Text=string.format("💥 Enemy Damage: %s (%s)",formatNumber(ed),formatCommas(ed))
 advanced.phealth.Text=string.format("🛡️ Your Health: %s (%s)",formatNumber(ph),formatCommas(ph))
 advanced.pdmg.Text=string.format("💥 Your Damage: %s (%s)",formatNumber(pd),formatCommas(pd))
 advanced.hits.Text="👊 Hits to Kill: "..tostring(hits)
end

