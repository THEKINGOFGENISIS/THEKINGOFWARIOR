local machineLastActivate=0

--// NEW MACHINE LOCK
local machineLocked=false
local machineLockCFrame=nil
local machineLockMachine=nil

local function getMachineInteract(machine)
 if not machine then return nil end

 for _,o in ipairs(machine:GetDescendants()) do
  if o:IsA("Seat") or o:IsA("VehicleSeat") then
   return o
  end
 end

 for _,o in ipairs(machine:GetDescendants()) do
  if o:IsA("BasePart") and o.Name:lower()=="interactseat" then
   return o
  end
 end

 return nil
end

local function getMachinePrompt(machine)
 if not machine then return nil end

 for _,o in ipairs(machine:GetDescendants()) do
  if o:IsA("ProximityPrompt") then
   return o
  end
 end

 return nil
end

local function machineTeleport(cf)
 local character=Player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not root or not cf then return false end

 if (root.Position-cf.Position).Magnitude>3 then
  root.CFrame=cf
  root.AssemblyLinearVelocity=Vector3.zero
  root.AssemblyAngularVelocity=Vector3.zero
  machineLastTeleport=os.clock()
  return true
 end

 return false
end

local function releaseMachineLock()
 machineLocked=false
 machineLockCFrame=nil
 machineLockMachine=nil

 local character=Player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")

 if root then
  root.AssemblyLinearVelocity=Vector3.zero
  root.AssemblyAngularVelocity=Vector3.zero
 end
end

local function setMachineLock(root,machine)
 if not root or not machine then return end

 -- Save the exact position after the machine has been activated.
 machineLockCFrame=root.CFrame
 machineLockMachine=machine
 machineLocked=true

 root.AssemblyLinearVelocity=Vector3.zero
 root.AssemblyAngularVelocity=Vector3.zero
end

local function maintainMachineLock()
 if not machineActive or not machineLocked or not machineLockCFrame then return end

 local character=Player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not root then return end

 -- No Anchored here.
 -- Only correct noticeable displacement to keep the player locked.
 local distance=(root.Position-machineLockCFrame.Position).Magnitude

 if distance>.65 then
  pcall(function()
   root.CFrame=machineLockCFrame
   root.AssemblyLinearVelocity=Vector3.zero
   root.AssemblyAngularVelocity=Vector3.zero
  end)
 elseif distance>.08 then
  pcall(function()
   root.CFrame=CFrame.new(machineLockCFrame.Position)*machineLockCFrame.Rotation
   root.AssemblyLinearVelocity=Vector3.zero
   root.AssemblyAngularVelocity=Vector3.zero
  end)
 end
end

local function activateMachine(machine,interact)
 local character=Player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local root=character and character:FindFirstChild("HumanoidRootPart")
 if not humanoid or not root then return false end

 local prompt=getMachinePrompt(machine)

 if prompt then
  local fired=false

  if typeof(fireproximityprompt)=="function" then
   fired=pcall(function()
    fireproximityprompt(prompt)
   end)
  end

  if not fired then
   pcall(function()
    Services.VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.E,false,game)
    task.wait(.04)
    Services.VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.E,false,game)
   end)
  end
 else
  pcall(function()
   Services.VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.E,false,game)
   task.wait(.04)
   Services.VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.E,false,game)
  end)
 end

 machineLastActivate=os.clock()

 -- Wait for the machine/seat to actually take effect.
 task.wait(.12)

 -- Lock AFTER using the machine.
 if machineActive and root.Parent and humanoid.Health>0 then
  setMachineLock(root,machine)
 end

 return true
end

FarmingTab:Toggle("Auto Machine Exercise",false,function(s)
 machineActive=s

 if not s then
  -- IMPORTANT: immediately release machine lock.
  releaseMachineLock()
  machineTarget=nil
  return
 end

 task.spawn(function()
  local lastMachine=nil

  while machineActive do
   refreshCharacter()

   local character=PlayerData.Character
   local root=character and character:FindFirstChild("HumanoidRootPart")
   local humanoid=PlayerData.Humanoid
   local machine=selectedMachine and machinesFolder:FindFirstChild(selectedMachine)
   local interact=getMachineInteract(machine)

   if root and humanoid and humanoid.Health>0 and machine and interact then

    -- If the user changes machine, release the old lock first.
    if machineLockMachine and machineLockMachine~=machine then
     releaseMachineLock()
    end

    local targetCF=interact.CFrame*CFrame.new(0,2.5,0)
    local changed=lastMachine~=machine
    local far=(root.Position-interact.Position).Magnitude>4

    -- Initial movement to the selected machine.
    if not machineLocked and (changed or far) then
     machineTarget=machine
     machineTeleport(targetCF)
     lastMachine=machine
     task.wait(.20)
    end

    -- Activate machine.
    if not machineLocked and os.clock()-machineLastActivate>=.35 then
     activateMachine(machine,interact)
    end

    -- Once activated, maintain the saved location.
    if machineLocked then
     maintainMachineLock()
    end

    -- Continue reps.
    if humanoid.SeatPart then
     pcall(function()
      Remotes.MuscleEvent:FireServer("rep")
     end)
    elseif machineLocked then
     pcall(function()
      Remotes.MuscleEvent:FireServer("rep")
     end)
    elseif (root.Position-interact.Position).Magnitude<=5 then
     pcall(function()
      Remotes.MuscleEvent:FireServer("rep")
     end)
    elseif not machineLocked then
     machineTeleport(targetCF)
    end

   else
    lastMachine=nil
    machineTarget=nil
    releaseMachineLock()
   end

   task.wait(.12)
  end

  -- Extra safety: always unlock when loop ends.
  releaseMachineLock()
 end)
end)

