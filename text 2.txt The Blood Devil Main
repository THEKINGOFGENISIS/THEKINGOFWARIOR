 hits=StatsTab:Label("👊 Hits to Kill: N/A")
}

local function calcHealth(target)
 if not target then return 0 end
 local d=target:FindFirstChild("Durability") or (target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Durability"))
 if not d then return 0 end

 local mult=1
 local u=target:FindFirstChild("ultimatesFolder")
 local h=u and u:FindFirstChild("Infernal Health")
 if h then mult+=.15*(tonumber(h.Value) or 0) end

 local pets=target:FindFirstChild("equippedPets")
 if pets then
  for _,v in ipairs(pets:GetChildren()) do
   if v:IsA("ObjectValue") and v.Value then
    local n=v.Value.Name:lower()
    if n:match("mighty") and n:match("monster") then
     mult+=.5
    elseif n:match("small") and n:match("fry") then
     mult+=.25
    end
   end
  end
 end

 return d.Value*mult
end

local function calcDamage(target)
 if not target then return 0 end
 local ls=target:FindFirstChild("leaderstats")
 local s=ls and ls:FindFirstChild("Strength")
 if not s then return 0 end

 local mult=1
 local u=target:FindFirstChild("ultimatesFolder")
 local d=u and u:FindFirstChild("Demon Damage")
 if d then mult+=.1*(tonumber(d.Value) or 0) end

 local pets=target:FindFirstChild("equippedPets")
 if pets then
  for _,v in ipairs(pets:GetChildren()) do
   if v:IsA("ObjectValue") and v.Value then
    local n=v.Value.Name:lower()
    if n:match("wild") and n:match("wizard") then
     mult+=.5
    elseif n:match("chaos") and n:match("sorcerer") then
     mult+=.25
    end
   end
  end
 end

 return s.Value*.06666666666666667*mult
end

local function updateAdvanced(target)
 if not target then
  advanced.health.Text="🛡️ Enemy Health: N/A"
  advanced.edmg.Text="💥 Enemy Damage: N/A"
  advanced.phealth.Text="🛡️ Your Health: N/A"
  advanced.pdmg.Text="💥 Your Damage: N/A"
  advanced.hits.Text="👊 Hits to Kill: N/A"
  return
 end

 local eh,ed=calcHealth(target),calcDamage(target)
 local ph,pd=calcHealth(Player),calcDamage(Player)
 local hits=pd<=0 and "∞" or math.ceil(eh/pd)
 if tonumber(hits) and hits>200 then hits="∞" end

