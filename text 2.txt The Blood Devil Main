AutoBossTab:Section("Boss Scanner")

local BossNames={
 Boss1=true,
 Boss2=true,
 Boss3=true,
 Boss4=true,
 Boss5=true,
 ["Boss Rainbow"]=true
}

local AutoFollow=false
local CurrentBoss=nil
local FollowDistance=3

local BossLabel=AutoBossTab:Label("Boss: None")
local SpawnLabel=AutoBossTab:Label("BossSpawn: Checking...")
local BossStatus=AutoBossTab:Label("Status: Waiting...")

local function getBossRoot(model)
 if not model or not model.Parent then return nil end
 if model:IsA("BasePart") then return model end

 local root=model:FindFirstChild("HumanoidRootPart")
  or model:FindFirstChild("UpperTorso")
  or model:FindFirstChild("Torso")
  or model.PrimaryPart

 if root and root:IsA("BasePart") then return root end

 for _,v in ipairs(model:GetDescendants()) do
  if v:IsA("BasePart") then return v end
 end
end

local function isValidBoss(obj)
 return obj
  and BossNames[obj.Name]
  and (obj:IsA("Model") or obj:IsA("BasePart"))
  and getBossRoot(obj)~=nil
end

local function findBoss()
 for _,name in ipairs({"Boss1","Boss2","Boss3","Boss4","Boss5","Boss Rainbow"}) do
  local obj=Services.Workspace:FindFirstChild(name)
  if isValidBoss(obj) then return obj end
 end

 for _,obj in ipairs(Services.Workspace:GetDescendants()) do
  if isValidBoss(obj) then return obj end
 end
end

local function findBossSpawn()
 local events=Services.Workspace:FindFirstChild("Events")
 local arena=events and events:FindFirstChild("BossArena")
 local spawn=arena and arena:FindFirstChild("BossSpawn")

 if spawn and (spawn:IsA("BasePart") or spawn:IsA("Model")) then
  return spawn
 end
end

local function getObjectPosition(obj)
 if not obj then return nil end
 if obj:IsA("BasePart") then return obj.Position end

 if obj:IsA("Model") then
  local root=getBossRoot(obj)
  return root and root.Position
 end
end

local function scanBoss()
 local boss=findBoss()

 if boss then
  CurrentBoss=boss

  local root=getBossRoot(boss)
  BossLabel.Text="Boss: "..boss.Name
  BossStatus.Text=root and ("FOUND | "..math.floor(root.Position.X)..", "..math.floor(root.Position.Y)..", "..math.floor(root.Position.Z)) or "FOUND"
  return boss
 end

 CurrentBoss=nil
 BossLabel.Text="Boss: None"

 local spawn=findBossSpawn()
 SpawnLabel.Text=spawn and "BossSpawn: FOUND" or "BossSpawn: NOT FOUND"
 BossStatus.Text=spawn and "Status: No boss - waiting for spawn" or "Status: Boss not found"
end

AutoBossTab:Button("Scan Boss",function()
 scanBoss()
end)

AutoBossTab:Button("Scan Workspace Bosses",function()
 local found={}

 for _,obj in ipairs(Services.Workspace:GetDescendants()) do
  if BossNames[obj.Name] and isValidBoss(obj) and not table.find(found,obj.Name) then
   table.insert(found,obj.Name)
  end
 end

 BossStatus.Text=#found>0 and ("Found: "..table.concat(found,", ")) or "Found: NONE"
end)

AutoBossTab:Slider("Follow Distance",1,15,3,function(v)
 FollowDistance=v
end)

AutoBossTab:Label("Auto Boss includes Fast Punch automatically. No Fast Animation is used.")

AutoBossTab:Toggle("Auto Follow Boss",false,function(state)
 AutoFollow=state

 if state then
  scanBoss()
  BossStatus.Text="Status: Auto Follow + Fast Punch ON"
 else
  BossStatus.Text="Status: Auto Follow + Fast Punch OFF"
 end
end)

task.spawn(function()
 while task.wait(.10) do
  if not AutoFollow then continue end

  local character=Player.Character
  local root=character and character:FindFirstChild("HumanoidRootPart")
  if not root then continue end

  if not CurrentBoss or not CurrentBoss.Parent or not isValidBoss(CurrentBoss) then
   CurrentBoss=findBoss()
  end

  if CurrentBoss then
   local bossRoot=getBossRoot(CurrentBoss)

   if bossRoot then
    local desired=bossRoot.CFrame.Position+bossRoot.CFrame.LookVector*FollowDistance
    local distance=(root.Position-desired).Magnitude

    if distance>2 then
     pcall(function()
      root.CFrame=CFrame.lookAt(desired,bossRoot.Position)
      root.AssemblyLinearVelocity=Vector3.zero
      root.AssemblyAngularVelocity=Vector3.zero
     end)
    end

    BossLabel.Text="Boss: "..CurrentBoss.Name
    BossStatus.Text=string.format(
     "Status: Following %s | %.1f studs | Fast Punch ON",
     CurrentBoss.Name,
     FollowDistance
    )
   end
  else
   local spawn=findBossSpawn()
   local pos=getObjectPosition(spawn)

   if pos and (root.Position-pos).Magnitude>4 then
    pcall(function()
     root.CFrame=CFrame.new(pos+Vector3.new(0,3,0))
     root.AssemblyLinearVelocity=Vector3.zero
     root.AssemblyAngularVelocity=Vector3.zero
    end)
   end

   BossStatus.Text="Status: Waiting at BossSpawn | Fast Punch ready"
  end
 end
end)

