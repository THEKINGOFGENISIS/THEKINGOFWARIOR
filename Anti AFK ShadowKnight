--//========================================================
--// TAB SWITCH
--//========================================================

local function ShowPage(Name)

    for PageName, Page in pairs(Pages) do
        Page.Visible = (PageName == Name)
    end

    --// Highlight selected tab
    for _, Object in ipairs(Sidebar:GetChildren()) do

        if Object:IsA("TextButton") then

            if Object.Text == Name then
                Object.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                Object.TextColor3 = Color3.fromRGB(0, 0, 0)
            else
                Object.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                Object.TextColor3 = Color3.fromRGB(220, 220, 220)
            end

        end

    end
end

MainTab.MouseButton1Click:Connect(function()
    ShowPage("MAIN")
end)

InfoTab.MouseButton1Click:Connect(function()
    ShowPage("INFO")
end)

