--//========================================================
--// GET REBIRTH STAT
--//========================================================

local function GetRebirthStat()

    local leaderstats = LP:FindFirstChild("leaderstats")

    if not leaderstats then
        return nil
    end

    return leaderstats:FindFirstChild("Rebirths")
end

--//========================================================
--// REBIRTH THEN KICK
--//========================================================

local function RebirthAndKick()

    if not CONFIG.RebirthBeforeKick then

        LP:Kick("cút đi thằng thằng chó trong blacklist🤣")

        return
    end

    local events = ReplicatedStorage:FindFirstChild("rEvents")

    if not events then
        warn("rEvents not found")
        return
    end

    local rebirthRemote = events:FindFirstChild("rebirthRemote")

    if not rebirthRemote then
        warn("rebirthRemote not found")
        return
    end

    local rebirthStat = GetRebirthStat()

    if not rebirthStat then
        warn("Rebirths stat not found")
        return
    end

    local before = tonumber(rebirthStat.Value) or 0

    print("Blacklist detected.")
    print("Rebirth before kick...")
    print("Current Rebirths:", before)

    local success, result = pcall(function()

        return rebirthRemote:InvokeServer("rebirthRequest")

    end)

    if not success then

        warn("Rebirth failed:", result)

        return
    end

    print("Rebirth request sent.")

    --//====================================================
    --// WAIT FOR ACTUAL REBIRTH CHANGE
    --// No fixed wait time
    --//====================================================

    local connection

    connection = rebirthStat:GetPropertyChangedSignal("Value"):Connect(
        function()

            local current =
                tonumber(rebirthStat.Value) or 0

            if current > before then

                if connection then
                    connection:Disconnect()
                    connection = nil
                end

                print("Rebirth confirmed:", current)
                print("Kicking...")

                LP:Kick(
                    "cút đi thằng thằng chó trong blacklist🤣"
                )
            end
        end
    )

    --//====================================================
    --// Handle immediate change
    --//====================================================

    local current =
        tonumber(rebirthStat.Value) or 0

    if current > before then

        if connection then
            connection:Disconnect()
            connection = nil
        end

        print("Rebirth confirmed:", current)

        LP:Kick(
            "cút đi thằng thằng chó trong blacklist🤣"
        )
    end
end

