--//========================================================
--// NAME CHECK
--//========================================================

local function CleanName(name)
    return string.lower(
        (tostring(name):gsub("^@", ""))
    )
end

local function InList(list, name)

    name = CleanName(name)

    for _, v in ipairs(list) do
        if CleanName(v) == name then
            return true
        end
    end

    return false
end

--//========================================================
--// ACCESS
--//========================================================

local function GetAccess()

    local name = LP.Name

    -- Blacklist takes priority
    if InList(CONFIG.Blacklist, name) then
        return "BLACKLIST"
    end

    if InList(CONFIG.Whitelist, name) then
        return "WHITELIST"
    end

    return "NONE"
end

