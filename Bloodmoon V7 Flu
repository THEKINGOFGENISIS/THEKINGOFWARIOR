local function FindPlayer(name)

    name = string.lower(name or "")

    if name == "" then
        return nil
    end

    for _,player in ipairs(Players:GetPlayers()) do

        if
            string.lower(player.Name) == name
            or
            string.lower(player.DisplayName) == name
        then
            return player
        end

    end

    for _,player in ipairs(Players:GetPlayers()) do

        if string.sub(
            string.lower(player.Name),
            1,
            #name
        ) == name then

            return player

        end

    end

    return nil

end

local function FindNearest()

    local char = P.Character
    local root =
        char and char:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local nearest = nil
    local distance = math.huge

    for _,player in ipairs(Players:GetPlayers()) do

        if player ~= P then

            local c = player.Character
            local r =
                c and c:FindFirstChild("HumanoidRootPart")

            if r then

                local d =
                    (root.Position-r.Position).Magnitude

                if d < distance then
                    distance = d
                    nearest = player
                end

            end

        end

    end

    return nearest

end

