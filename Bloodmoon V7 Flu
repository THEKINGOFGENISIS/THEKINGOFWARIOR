local function CleanSoundId(value)

    value = tostring(value or "")

    value =
        value:gsub(
            "rbxassetid://",
            ""
        )

    value =
        value:gsub(
            "%s+",
            ""
        )

    return value

end

local function RandomMusicPlay()

    if #MusicList == 0 then
        return false
    end

    local id =
        MusicList[
            math.random(
                1,
                #MusicList
            )
        ]

    MusicId =
        CleanSoundId(id)

    Music.SoundId =
        "rbxassetid://"..MusicId

    Music.Volume =
        MusicVolume

    Music.Looped = false

    pcall(function()
        Music:Play()
    end)

    MusicPlaying = true

    return true

end

