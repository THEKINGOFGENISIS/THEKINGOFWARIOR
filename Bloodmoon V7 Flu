            char and
            char:FindFirstChildOfClass(
                "Humanoid"
            )

        local root =
            char and
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        local camera =
            workspace.CurrentCamera

        if
            not humanoid
            or
            not root
            or
            not camera
        then

            return

        end

        local look =
            camera.CFrame.LookVector

        local flat =
            Vector3.new(
                look.X,
                0,
                look.Z
            )

        if flat.Magnitude > .001 then

            humanoid.AutoRotate = false

            root.CFrame =
                CFrame.lookAt(
                    root.Position,
                    root.Position+flat.Unit
                )

        end

    end
)

