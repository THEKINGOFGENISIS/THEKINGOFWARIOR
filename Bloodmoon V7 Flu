--======================================================

P.CharacterAdded:Connect(function(
    character
)

    task.wait(1)

    LockedCFrame = nil

    --==================================================
    -- HIDE STATS SAU RESPAWN
    --==================================================

    if HideStats then

        -- Kết nối watcher cho Character mới
        SetStatsVisible(true)

        -- Quét thêm lần nữa vì nhiều game
        -- tạo bảng stats trễ sau khi spawn
        task.wait(.5)

        if HideStats then
            ScanStats(character)
        end

        task.wait(.5)

        if HideStats then
            ScanStats(character)
            ScanStats(PlayerGui)
        end

    end

    if DashEnabled then
        DashButton.Visible = true
    end

end)

