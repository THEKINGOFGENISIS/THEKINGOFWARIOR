--======================================================
-- HIDE STATS V7 FIX
--======================================================
-- Quét cả Character + PlayerGui
-- Nhận diện theo tên object và nội dung text
-- Theo dõi object mới được tạo
-- Có thể restore trạng thái ban đầu
--======================================================

local HiddenStatsObjects = {}

local StatKeywords = {

    "stat",
    "stats",

    "strength",
    "muscle",
    "power",

    "energy",
    "stamina",
    "speed",

    "wins",
    "win",

    "cash",
    "coin",
    "coins",
    "money",

    "rebirth",
    "rebirths",

    "multiplier",
    "multipliers",
    "mult",

    "level",
    "lvl",

    "rank",

    "score",
    "scores",

    "point",
    "points",

    "damage",
    "kills",
    "kill",

    "punch",
    "push",
    "lift",
    "weight",

    "value",

    "leaderstats",

    "powerlevel",
    "power level",

    "total",

    "kg",
    "lb"
}

local function ContainsStatKeyword(text)

    if not text then
        return false
    end

    text = string.lower(tostring(text))

    for _,keyword in ipairs(StatKeywords) do

        if string.find(
            text,
            keyword,
            1,
            true
        ) then

            return true

        end

    end

    return false

end

local function IsStatObject(obj)

    if not obj then
        return false
    end

    local objectName =
        string.lower(obj.Name or "")

    if ContainsStatKeyword(objectName) then
        return true
    end

    --==================================================
    -- KIỂM TRA TEXT
    --==================================================

    if
        obj:IsA("TextLabel")
        or
        obj:IsA("TextButton")
        or
        obj:IsA("TextBox")
    then

        if ContainsStatKeyword(obj.Text) then
            return true
        end

    end

    return false

end

local function SaveAndHide(obj)

    if not obj then
        return
    end

    --==================================================
    -- BILLBOARD / SURFACE GUI
    --==================================================

    if
        obj:IsA("BillboardGui")
        or
        obj:IsA("SurfaceGui")
    then

        if HiddenStatsObjects[obj] == nil then

            HiddenStatsObjects[obj] = {
                Type = "Enabled",
                Value = obj.Enabled
            }

        end

        obj.Enabled = false

        return

    end

    --==================================================
    -- TEXT OBJECT
    --==================================================

    if
        obj:IsA("TextLabel")
        or
        obj:IsA("TextButton")
        or
        obj:IsA("TextBox")
    then

        if HiddenStatsObjects[obj] == nil then

            HiddenStatsObjects[obj] = {
                Type = "Visible",
                Value = obj.Visible
            }

        end

        obj.Visible = false

        return

    end

end

local function ScanStats(container)

    if not container then
        return
    end

    for _,obj in ipairs(
        container:GetDescendants()
    ) do

        if IsStatObject(obj) then

            SaveAndHide(obj)

        end

    end

end

local function RestoreAllStats()

    for obj,data in pairs(
        HiddenStatsObjects
    ) do

        if obj and obj.Parent then

            pcall(function()

                if data.Type == "Enabled" then

                    obj.Enabled = data.Value

                elseif data.Type == "Visible" then

                    obj.Visible = data.Value

                end

            end)

        end

    end

    HiddenStatsObjects = {}

end

local HideStatsConnections = {}

local function DisconnectHideStatsConnections()

    for _,connection in ipairs(
        HideStatsConnections
    ) do

        pcall(function()
            connection:Disconnect()
        end)

    end

    HideStatsConnections = {}

end

local function ConnectHideStatsWatcher(container)

    if not container then
        return
    end

    local connection =
        container.DescendantAdded:Connect(
            function(obj)

                if not HideStats then
                    return
                end

                task.defer(function()

                    if IsStatObject(obj) then

                        SaveAndHide(obj)

                    end

                    -- Một số GUI tạo children
                    -- sau khi object chính được tạo

                    task.defer(function()

                        if HideStats then
                            ScanStats(container)
                        end

                    end)

                end)

            end
        )

    table.insert(
        HideStatsConnections,
        connection
    )

end

local function SetStatsVisible(state)

    HideStats = state

    DisconnectHideStatsConnections()

    --==================================================
    -- TẮT HIDE STATS
    --==================================================

    if not HideStats then

        RestoreAllStats()

        return

    end

    --==================================================
    -- BẬT HIDE STATS
    --==================================================

    -- Character
    if P.Character then

        ScanStats(P.Character)

        ConnectHideStatsWatcher(
            P.Character
        )

    end

    -- PlayerGui
    ScanStats(PlayerGui)

    ConnectHideStatsWatcher(
        PlayerGui
    )

end

--======================================================
-- FIX LAG
--======================================================

local function ApplyLowGraphics(enabled)

    LowGraphics = enabled

    if enabled then

        OldLighting.Brightness =
            Lighting.Brightness

        OldLighting.GlobalShadows =
            Lighting.GlobalShadows

        OldLighting.FogEnd =
            Lighting.FogEnd

        Lighting.Brightness = 0
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000

    else

        if OldLighting.Brightness ~= nil then

            Lighting.Brightness =
                OldLighting.Brightness

        end

        if OldLighting.GlobalShadows ~= nil then

            Lighting.GlobalShadows =
                OldLighting.GlobalShadows

        end

        if OldLighting.FogEnd ~= nil then

            Lighting.FogEnd =
                OldLighting.FogEnd

        end

    end

    for _,obj in ipairs(
        workspace:GetDescendants()
    ) do

        if
            obj:IsA("ParticleEmitter")
            or
            obj:IsA("Trail")
            or
            obj:IsA("Beam")
        then

            obj.Enabled = not enabled

        elseif obj:IsA("BasePart") then

            if enabled then

                if not OldGraphics[obj] then

                    OldGraphics[obj] =
                        obj.Material

                end

                obj.Material =
                    Enum.Material.SmoothPlastic

            elseif OldGraphics[obj] then

                obj.Material =
                    OldGraphics[obj]

            end

        end

    end

end

