local FXConnection

local function StartTeleportFX()

    if not TeleportAnimation then
        return
    end

    Ring1.Visible = true
    Ring2.Visible = true
    Ring3.Visible = true
    FXText.Visible = true

    for _,v in ipairs(Segments) do
        v.Visible = true
    end

    Ring1.Size = UDim2.fromOffset(80,80)
    Ring2.Size = UDim2.fromOffset(55,55)
    Ring3.Size = UDim2.fromOffset(35,35)

    if FXConnection then
        FXConnection:Disconnect()
    end

    local rotation = 0

    FXConnection =
        RunService.RenderStepped:Connect(function(dt)

            rotation += dt*260

            Ring1.Rotation = rotation
            Ring2.Rotation = -rotation*1.5
            Ring3.Rotation = rotation*2

            for i,segment in ipairs(Segments) do

                local angle =
                    math.rad((i-1)*30+rotation)

                segment.Position =
                    UDim2.new(
                        .5,
                        math.cos(angle)*110,
                        .5,
                        math.sin(angle)*110
                    )

                segment.Rotation =
                    rotation+i*30

            end

        end)

    TweenService:Create(
        Ring1,
        TweenInfo.new(.3,Enum.EasingStyle.Back),
        {Size=UDim2.fromOffset(240,240)}
    ):Play()

    TweenService:Create(
        Ring2,
        TweenInfo.new(.3,Enum.EasingStyle.Back),
        {Size=UDim2.fromOffset(180,180)}
    ):Play()

    TweenService:Create(
        Ring3,
        TweenInfo.new(.3,Enum.EasingStyle.Back),
        {Size=UDim2.fromOffset(110,110)}
    ):Play()

end

local function StopTeleportFX()

    if FXConnection then
        FXConnection:Disconnect()
        FXConnection = nil
    end

    for _,ring in ipairs({Ring1,Ring2,Ring3}) do

        local stroke =
            ring:FindFirstChildOfClass("UIStroke")

        if stroke then
            stroke.Transparency = 1
        end

    end

    FXText.TextTransparency = 1

    task.delay(.25,function()

        for _,ring in ipairs({Ring1,Ring2,Ring3}) do

            ring.Visible = false

            local stroke =
                ring:FindFirstChildOfClass("UIStroke")

            if stroke then
                stroke.Transparency = 0
            end

        end

        FXText.Visible = false
        FXText.TextTransparency = 0

        for _,v in ipairs(Segments) do
            v.Visible = false
        end

    end)

end

local function TeleportToPlayer(target)

    if TeleportBusy or not target then
        return false
    end

    local char = P.Character
    local root =
        char and char:FindFirstChild("HumanoidRootPart")

    local tc = target.Character
    local tr =
        tc and tc:FindFirstChild("HumanoidRootPart")

    if not root or not tr then
        return false
    end

    TeleportBusy = true

    StartTeleportFX()

    task.wait(
        TeleportAnimation and .55 or 0
    )

    root.CFrame =
        tr.CFrame*CFrame.new(0,0,3)

    StopTeleportFX()

    TeleportBusy = false

    return true

end

