-- FARM
--======================================================

task.spawn(function()

    while task.wait(.1) do

        if
            AutoFarm
            and
            SelectedTool
            and
            not FarmRunning
        then

            FarmRunning = true

            local player = P
            local char =
                player.Character

            if char then

                local humanoid =
                    char:FindFirstChildOfClass(
                        "Humanoid"
                    )

                local tool =
                    char:FindFirstChild(
                        SelectedTool
                    )

                if not tool then

                    tool =
                        player.Backpack:
                        FindFirstChild(
                            SelectedTool
                        )

                    if
                        tool
                        and
                        humanoid
                    then

                        pcall(function()

                            humanoid:EquipTool(
                                tool
                            )

                        end)

                    end

                end

                if tool then

                    pcall(function()
                        tool:Activate()
                    end)

                end

            end

            FarmRunning = false

        end

    end

end)

--======================================================
-- FAST ANIMATION
--======================================================

task.spawn(function()

    while task.wait(.1) do

        if FastAnimation then

            local char =
                P.Character

            local humanoid =
                char
                and
                char:FindFirstChildOfClass(
                    "Humanoid"
                )

            if humanoid then

                for _,track in ipairs(
                    humanoid:GetPlayingAnimationTracks()
                ) do

                    pcall(function()

                        track:AdjustSpeed(
                            FastAnimationSpeed
                        )

                    end)

                end

            end

        end

    end

end)

--======================================================
-- AUTO CLICK / AUTO PUNCH
--======================================================

task.spawn(function()

    while task.wait(
        AutoInterval
    ) do

        if
            AutoClick
            or
            AutoPunch
        then

            local char =
                P.Character

            if char then

                local tool =
                    char:FindFirstChildOfClass(
                        "Tool"
                    )

                if tool then

                    pcall(function()
                        tool:Activate()
                    end)

                end

            end

        end

    end

end)

