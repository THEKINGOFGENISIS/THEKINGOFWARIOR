--======================================================
-- DASH DRAG
--======================================================

local dashDragging = false
local dashStart = nil
local dashPosition = nil

DashButton.InputBegan:Connect(function(input)

    if
        input.UserInputType ==
            Enum.UserInputType.Touch
        or
        input.UserInputType ==
            Enum.UserInputType.MouseButton1
    then

        dashDragging = true
        dashStart = input.Position
        dashPosition = DashButton.Position

    end

end)

UIS.InputChanged:Connect(function(input)

    if not dashDragging then
        return
    end

    if
        input.UserInputType ==
            Enum.UserInputType.Touch
        or
        input.UserInputType ==
            Enum.UserInputType.MouseMovement
    then

        local delta =
            input.Position-dashStart

        DashButton.Position =
            UDim2.new(
                dashPosition.X.Scale,
                dashPosition.X.Offset+delta.X,
                dashPosition.Y.Scale,
                dashPosition.Y.Offset+delta.Y
            )

    end

end)

UIS.InputEnded:Connect(function(input)

    if
        input.UserInputType ==
            Enum.UserInputType.Touch
        or
        input.UserInputType ==
            Enum.UserInputType.MouseButton1
    then

        dashDragging = false

    end

end)

