local function formatNumber(value)
    value = tonumber(value) or 0

    local abs = math.abs(value)

    local units = {
        {1e63,"Vg"},
        {1e60,"Nod"},
        {1e57,"Ocd"},
        {1e54,"Spd"},
        {1e51,"Sxd"},
        {1e48,"Qid"},
        {1e45,"Qad"},
        {1e42,"Tdc"},
        {1e39,"Ddc"},
        {1e36,"Udc"},
        {1e33,"Dc"},
        {1e30,"No"},
        {1e27,"Oc"},
        {1e24,"Sp"},
        {1e21,"Sx"},
        {1e18,"Qi"},
        {1e15,"Qa"},
        {1e12,"T"},
        {1e9,"B"},
        {1e6,"M"},
        {1e3,"K"}
    }

    for _,unit in ipairs(units) do
        if abs >= unit[1] then
            return string.format("%.2f%s",value/unit[1],unit[2])
        end
    end

    if value % 1 == 0 then
        return string.format("%.0f",value)
    end

    return string.format("%.2f",value)
end

local function startTracking(stat,value)
    value = tonumber(value) or 0

    stat.Current = value
    stat.Last = value
    stat.Received = 0
    table.clear(stat.History)

    table.insert(stat.History,{
        Time = os.clock(),
        Value = value
    })
end

local function recordStat(stat,value)
    value = tonumber(value) or 0

    local old = stat.Last or value

    if value > old then
        stat.Received += value - old
    end

    stat.Current = value
    stat.Last = value

    table.insert(stat.History,{
        Time = os.clock(),
        Value = value
    })

    if #stat.History > 3000 then
        table.remove(stat.History,1)
    end
end

local function receivedPeriod(stat,seconds)
    local now = os.clock()
    local cutoff = now - seconds

    local oldest

    for i = #stat.History,1,-1 do
        local item = stat.History[i]

        if item.Time <= cutoff then
            oldest = item.Value
            break
        end
    end

    if oldest == nil then
        oldest = stat.History[1] and stat.History[1].Value or stat.Current
    end

    local amount = stat.Current - oldest

    if amount < 0 then
        amount = 0
    end

    return amount
end

