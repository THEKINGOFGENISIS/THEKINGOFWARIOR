local function unequipAllPets()
    local petsFolder = Player:FindFirstChild("petsFolder")
    if not petsFolder then return end

    local events = ReplicatedStorage:FindFirstChild("rEvents")
    local equipEvent = events and events:FindFirstChild("equipPetEvent")

    if not equipEvent then return end

    for _,folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _,pet in ipairs(folder:GetChildren()) do
                pcall(function()
                    equipEvent:FireServer("unequipPet",pet)
                end)
            end
        end
    end

    task.wait(0.1)
end

local function equipFarmingPets()
    unequipAllPets()

    local petsFolder = Player:FindFirstChild("petsFolder")
    local unique = petsFolder and petsFolder:FindFirstChild("Unique")

    local events = ReplicatedStorage:FindFirstChild("rEvents")
    local equipEvent = events and events:FindFirstChild("equipPetEvent")

    if not unique or not equipEvent then return end

    local omegas,swifts,hounds = {},{},{}

    for _,pet in ipairs(unique:GetChildren()) do
        if pet.Name == "Omega Overlord" then
            table.insert(omegas,pet)
        elseif pet.Name == "Swift Samurai" then
            table.insert(swifts,pet)
        elseif pet.Name == "Powercore Hound" then
            table.insert(hounds,pet)
        end
    end

    local equipped = 0
    local percent = 0
    local maxSlots = 9

    for i = #omegas,1,-1 do
        if equipped >= maxSlots then break end
        if percent < 100 then
            pcall(function()
                equipEvent:FireServer("equipPet",omegas[i])
            end)
            percent += 20
            equipped += 1
        end
    end

    for i = #swifts,1,-1 do
        if equipped >= maxSlots then break end
        if percent < 100 then
            pcall(function()
                equipEvent:FireServer("equipPet",swifts[i])
            end)
            percent += 15
            equipped += 1
        end
    end

    if percent >= 100 then
        for i = #hounds,1,-1 do
            if equipped >= maxSlots then break end

            pcall(function()
                equipEvent:FireServer("equipPet",hounds[i])
            end)

            equipped += 1
        end
    end

    for i = #omegas,1,-1 do
        if equipped >= maxSlots then break end

        pcall(function()
            equipEvent:FireServer("equipPet",omegas[i])
        end)

        equipped += 1
    end

    for i = #swifts,1,-1 do
        if equipped >= maxSlots then break end

        pcall(function()
            equipEvent:FireServer("equipPet",swifts[i])
        end)

        equipped += 1
    end
end

local function equipRebirthPets()
    unequipAllPets()

    local petsFolder = Player:FindFirstChild("petsFolder")
    local unique = petsFolder and petsFolder:FindFirstChild("Unique")

    local events = ReplicatedStorage:FindFirstChild("rEvents")
    local equipEvent = events and events:FindFirstChild("equipPetEvent")

    if not unique or not equipEvent then return end

