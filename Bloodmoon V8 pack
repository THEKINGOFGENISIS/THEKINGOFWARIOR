        toggleBlackScreen()
    end)
end)

--========================================================
-- BLACK SCREEN ENABLE / DISABLE
--========================================================

local function enableBlackSystem()

    Config.BlackScreen = true

    BlackButton.Visible = true

    updateBlackButton()
end

local function disableBlackSystem()

    Config.BlackScreen = false

    -- Nếu đang loading thì không phá animation giữa chừng
    if blackBusy then

        task.spawn(function()

            while blackBusy do
                task.wait()
            end

            if not Config.BlackScreen then

                if Config.BlackScreenActive then
                    turnBright()
                end

                BlackButton.Visible = false
            end

        end)

        return
    end

    if Config.BlackScreenActive then
        turnBright()
    end

    BlackButton.Visible = false
    BlackBackground.BackgroundTransparency = 1
    LoadingEffect.Visible = false
    LoadingEffect.Rotation = 0

    Config.BlackScreenActive = false

    updateBlackButton()
end

local function setBlackScreen(state)

    state = state == true

    if state then
        enableBlackSystem()
    else
        disableBlackSystem()
    end
end

