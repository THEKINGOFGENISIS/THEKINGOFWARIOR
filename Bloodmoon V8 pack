--========================================================

local function minimize()

    if Library.Minimized then
        return
    end

    Library.Minimized = true
    Main.Visible = false

    MiniBar.Position =
        UDim2.new(0.5,-90,0.5,-19)

    MiniBar.Visible = true
end

local function restore()

    if not Library.Minimized then
        return
    end

    Library.Minimized = false
    MiniBar.Visible = false
    Main.Visible = true
end

Minimize.Activated:Connect(minimize)
MiniBar.Activated:Connect(restore)

function Library:Minimize()
    minimize()
end

function Library:Restore()
    restore()
end

function Library:Toggle()

    if Library.Minimized then
        restore()
    else
        minimize()
    end
end

function Library:Destroy()

    pcall(function()

        Config.BlackScreen = false
        Config.BlackScreenActive = false

        ScreenGui:Destroy()
        BlackScreenGui:Destroy()

    end)
end

