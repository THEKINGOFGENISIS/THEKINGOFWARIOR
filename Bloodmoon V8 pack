--========================================================

local HiddenGuiStates = {}
local HideStatsConnection

local function isBloodMoonGui(object)

    if not object then
        return true
    end

    if object == ScreenGui then
        return true
    end

    return string.find(
        string.lower(object.Name),
        "bloodmoon"
    ) ~= nil
end

local function hideGameStats()

    table.clear(HiddenGuiStates)

    local playerGui = Player:FindFirstChild("PlayerGui")

    if playerGui then

        for _,object in ipairs(playerGui:GetChildren()) do

            if object:IsA("ScreenGui")
            and not isBloodMoonGui(object) then

                HiddenGuiStates[object] = object.Enabled
                object.Enabled = false
            end
        end

        if HideStatsConnection then
            HideStatsConnection:Disconnect()
        end

        HideStatsConnection =
            playerGui.ChildAdded:Connect(function(object)

                if not Config.HideStats then
                    return
                end

                if object:IsA("ScreenGui")
                and not isBloodMoonGui(object) then

                    HiddenGuiStates[object] = object.Enabled
                    object.Enabled = false
                end
            end)
    end
end

local function showGameStats()

    if HideStatsConnection then
        HideStatsConnection:Disconnect()
        HideStatsConnection = nil
    end

    for object,state in pairs(HiddenGuiStates) do

        if object and object.Parent then

            pcall(function()
                object.Enabled = state
            end)

        end
    end

    table.clear(HiddenGuiStates)
end

