        Line.Size = UDim2.new(0,3,1,-8)
        Line.Position = UDim2.new(0,5,0,4)
        Line.BackgroundColor3 = COLORS.RedText
        Line.BorderSizePixel = 0
        Line.Parent = Section

        corner(Line,2)

        local Label = textLabel(
            Section,
            text,
            14,
            Enum.Font.GothamBold
        )

        Label.Position = UDim2.new(0,16,0,0)
        Label.Size = UDim2.new(1,-20,1,0)
        Label.TextColor3 = COLORS.RedText

        return Section
    end

    function Tab:AddButton(text,callback)

        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1,-5,0,40)
        Button.BackgroundColor3 = COLORS.Element
        Button.BorderSizePixel = 0
        Button.Text = text
        Button.TextColor3 = COLORS.Text
        Button.TextSize = 14
        Button.Font = Enum.Font.GothamSemibold
        Button.TextXAlignment = Enum.TextXAlignment.Left
        Button.AutoButtonColor = false
        Button.Parent = Page

        corner(Button,7)
        stroke(Button,Color3.fromRGB(90,8,12),1)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0,13)
        pad.Parent = Button

        Button.Activated:Connect(function()

            TweenService:Create(
                Button,
                TweenInfo.new(0.08),
                {
                    BackgroundColor3 = COLORS.ButtonHover
                }
            ):Play()

            task.delay(0.1,function()

                if Button.Parent then

                    TweenService:Create(
                        Button,
                        TweenInfo.new(0.12),
                        {
                            BackgroundColor3 = COLORS.Element
                        }
                    ):Play()

                end
            end)

            if callback then
                task.spawn(callback)
            end
        end)

        return Button
    end

    function Tab:AddSwitch(text,callback)

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1,-5,0,42)
        Holder.BackgroundColor3 = COLORS.Element
        Holder.BorderSizePixel = 0
        Holder.Parent = Page

        corner(Holder,7)
        stroke(Holder,Color3.fromRGB(90,8,12),1)

        local Label = textLabel(
            Holder,
            text,
            14,
            Enum.Font.GothamSemibold
        )

        Label.Position = UDim2.new(0,12,0,0)
        Label.Size = UDim2.new(1,-75,1,0)

        local Toggle = Instance.new("TextButton")
        Toggle.Size = UDim2.new(0,46,0,24)
        Toggle.Position = UDim2.new(1,-56,0.5,-12)
        Toggle.BackgroundColor3 = COLORS.SwitchOff
        Toggle.BorderSizePixel = 0
        Toggle.Text = ""
        Toggle.AutoButtonColor = false
        Toggle.Parent = Holder

        corner(Toggle,12)

        local Circle = Instance.new("Frame")
        Circle.Size = UDim2.new(0,18,0,18)
        Circle.Position = UDim2.new(0,3,0.5,-9)
        Circle.BackgroundColor3 = Color3.fromRGB(235,235,235)
        Circle.BorderSizePixel = 0
        Circle.Parent = Toggle

        corner(Circle,9)

        local state = false

        local Switch = {}

        function Switch:Set(value)

            state = value == true

            if state then

                TweenService:Create(
                    Toggle,
                    TweenInfo.new(0.15),
                    {
                        BackgroundColor3 = COLORS.SwitchOn
                    }
                ):Play()

                TweenService:Create(
                    Circle,
                    TweenInfo.new(0.15),
                    {
                        Position = UDim2.new(1,-21,0.5,-9)
                    }
                ):Play()

            else

                TweenService:Create(
                    Toggle,
                    TweenInfo.new(0.15),
                    {
                        BackgroundColor3 = COLORS.SwitchOff
                    }
                ):Play()

                TweenService:Create(
                    Circle,
                    TweenInfo.new(0.15),
                    {
                        Position = UDim2.new(0,3,0.5,-9)
                    }
                ):Play()

            end

            if callback then
                task.spawn(callback,state)
            end
        end

        function Switch:Get()
            return state
        end

        Toggle.Activated:Connect(function()
            Switch:Set(not state)
        end)

        return Switch
    end

    function Tab:AddTextBox(text,callback)

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1,-5,0,42)
        Holder.BackgroundColor3 = COLORS.Element
        Holder.BorderSizePixel = 0
        Holder.Parent = Page

        corner(Holder,7)
