local StrengthCard = createStatCard("Strengths")
local DurabilityCard = createStatCard("Durability")
local RebirthCard = createStatCard("Rebirths")

local function updateCard(card,stat)

    local hour = receivedPeriod(stat,60 * 60)
    local day = receivedPeriod(stat,60 * 60 * 24)
    local week = receivedPeriod(stat,60 * 60 * 24 * 7)

    card.Period.Text =
        "1 Hour: +" .. formatNumber(hour) ..
        " / 1 Day: +" .. formatNumber(day) ..
        " / 1 Week: +" .. formatNumber(week)

    card.Current.Text =
        "Hiện tại: " .. formatNumber(stat.Current)

    card.Received.Text =
        "Cài được: +" .. formatNumber(stat.Received)
end

