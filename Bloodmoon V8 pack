--========================================================
-- BUTTON DRAG
--========================================================

local blackButtonDragging = false
local blackButtonDragStart
local blackButtonStartPosition
local blackButtonMoved = false

BlackButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        blackButtonDragging = true
        blackButtonMoved = false

        blackButtonDragStart = input.Position
        blackButtonStartPosition = BlackButton.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                blackButtonDragging = false
            end

        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if blackButtonDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta =
            input.Position - blackButtonDragStart

        if math.abs(delta.X) > 5
        or math.abs(delta.Y) > 5 then

            blackButtonMoved = true
        end

        BlackButton.Position = UDim2.new(
            blackButtonStartPosition.X.Scale,
            blackButtonStartPosition.X.Offset + delta.X,

            blackButtonStartPosition.Y.Scale,
            blackButtonStartPosition.Y.Offset + delta.Y
        )
    end
end)

