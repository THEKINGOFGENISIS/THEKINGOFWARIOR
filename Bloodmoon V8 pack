--========================================================
-- TURN BLACK
--========================================================

local function turnBlack()

    if blackBusy then
        return
    end

    if Config.BlackScreenActive then
        return
    end

    blackBusy = true

    Config.BlackScreenActive = true
    updateBlackButton()

    -- chắc chắn bắt đầu từ sáng
    BlackBackground.BackgroundTransparency = 1

    LoadingEffect.Rotation = 0
    showLoading()

    --====================================================
    -- XOAY 180° TRONG ĐÚNG 2 GIÂY
    --====================================================

    local rotation = TweenService:Create(
        LoadingEffect,
        TweenInfo.new(
            2,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            Rotation = 180
        }
    )

    rotation:Play()

    -- Chờ đủ 2 giây
    rotation.Completed:Wait()

    --====================================================
    -- SAU KHI XOAY XONG -> ĐEN DẦN
    --====================================================

    local fadeBlack = TweenService:Create(
        BlackBackground,
        TweenInfo.new(
            0.8,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundTransparency = 0
        }
    )

    fadeBlack:Play()
    fadeBlack.Completed:Wait()

    hideLoading()

    LoadingEffect.Rotation = 0

    blackBusy = false
end

--========================================================
-- TURN BRIGHT
--========================================================

local function turnBright()

    if blackBusy then
        return
    end

    if not Config.BlackScreenActive then
        return
    end

    blackBusy = true

    --====================================================
    -- HIỆN LOADING TRƯỚC
    --====================================================

    LoadingEffect.Rotation = 180

    showLoading()

    --====================================================
    -- XOAY NGƯỢC 180° TRONG ĐÚNG 2 GIÂY
    --====================================================

    local rotation = TweenService:Create(
        LoadingEffect,
        TweenInfo.new(
            2,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            Rotation = 0
        }
    )

    rotation:Play()

    rotation.Completed:Wait()

    --====================================================
    -- SÁNG DẦN
    --====================================================

    local fadeClear = TweenService:Create(
        BlackBackground,
        TweenInfo.new(
            0.8,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundTransparency = 1
        }
    )

    fadeClear:Play()
    fadeClear.Completed:Wait()

    Config.BlackScreenActive = false
    updateBlackButton()

    hideLoading()

    blackBusy = false
end

--========================================================
-- TOGGLE BLACK SCREEN
--========================================================

local function toggleBlackScreen()

    if blackBusy then
        return
    end

    if Config.BlackScreenActive then
        turnBright()
    else
        turnBlack()
    end
end

--========================================================
-- FLOAT BUTTON CLICK
