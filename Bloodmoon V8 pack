        Label.Size = UDim2.new(0.45,0,1,0)

        local Box = Instance.new("TextBox")
        Box.Size = UDim2.new(0.45,0,0,28)
        Box.Position = UDim2.new(0.51,0,0.5,-14)
        Box.BackgroundColor3 = Color3.fromRGB(20,2,4)
        Box.BorderSizePixel = 0
        Box.Text = ""
        Box.PlaceholderText = "Enter..."
        Box.PlaceholderColor3 = Color3.fromRGB(130,100,100)
        Box.TextColor3 = COLORS.Text
        Box.TextSize = 13
        Box.Font = Enum.Font.Gotham
        Box.ClearTextOnFocus = false
        Box.Parent = Holder

        corner(Box,6)
        stroke(Box,COLORS.Border,1)

        Box.FocusLost:Connect(function()

            if callback then
                task.spawn(callback,Box.Text)
            end

        end)

        return Box
    end

    function Tab:AddSpace(height)

        local Space = Instance.new("Frame")
        Space.Size = UDim2.new(1,0,0,height or 6)
        Space.BackgroundTransparency = 1
        Space.Parent = Page

        return Space
    end

    table.insert(Library.Tabs,Tab)

    Button.Activated:Connect(function()
        Tab:Show()
    end)

    if not Library.CurrentTab then
        Tab:Show()
    end

    return Tab
end

