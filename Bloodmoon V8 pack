-- FAST REBIRTH
--========================================================

local function doRebirth()
    local rebirths = rebirthsStat.Value
    local target = 5000 + rebirths * 2550

    while Config.FastRebirth and strengthStat.Value < target do
        local reps =
            Player.MembershipType == Enum.MembershipType.Premium
            and 6
            or 12

        for _ = 1,reps do
            pcall(function()
                muscleEvent:FireServer("rep")
            end)
        end

        task.wait(0.02)
    end

    if Config.FastRebirth and strengthStat.Value >= target then
        equipRebirthPets()
        task.wait(0.25)

        local before = rebirthsStat.Value

        repeat
            local events = ReplicatedStorage:FindFirstChild("rEvents")
            local remote = events and events:FindFirstChild("rebirthRemote")

            if not remote then break end

            pcall(function()
                remote:InvokeServer("rebirthRequest")
            end)

            task.wait(0.05)

        until rebirthsStat.Value > before or not Config.FastRebirth
    end
end

task.spawn(function()
    while true do
        if Config.FastRebirth then
            pcall(equipFarmingPets)
            pcall(doRebirth)
            task.wait(0.5)
        else
            task.wait(0.2)
        end
    end
end)

--========================================================
-- FAST FARM
--========================================================

local networkStats =
    game:GetService("Stats").Network.ServerStatsItem["Data Ping"]

local function getPing()
    local ok,value = pcall(function()
        return networkStats:GetValue()
    end)

    return ok and value or 100
end

local function adaptiveSpeed(ping)
    if ping < 80 then
        return 500
    elseif ping < 150 then
        return 300
    elseif ping < 250 then
        return 100
    else
        return 50
    end
end

task.spawn(function()
    local lastUpdate = 0
    local ping = 100

    while true do
        if Config.FastFarm then

            if time() - lastUpdate > 0.5 then
                ping = getPing()
                lastUpdate = time()
            end

            local reps

            if Config.ControlledSpeed then
                reps = adaptiveSpeed(ping)
            else
                reps = Config.RepSpeed
            end

            reps = math.min(reps,Config.RepSpeed)

            local delay =
                math.clamp(ping / 2500,0.001,0.1)

            for i = 1,reps do
                if not Config.FastFarm then break end

                pcall(function()
                    muscleEvent:FireServer("rep")
                end)

                if i % 500 == 0 then
                    task.wait()
                end
            end

            task.wait(delay)
        else
            task.wait(0.1)
        end
    end
end)

