-- LOCK POSITION
--========================================================

local lockedPosition

local function lockPosition()
    if not Config.LockPosition or not lockedPosition then return end

    local root = getRoot()
    if not root then return end

    local existing = root:FindFirstChild("PositionLocker")

    if existing then
        existing.Position = lockedPosition
    else
        local body = Instance.new("BodyPosition")

        body.Name = "PositionLocker"
        body.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        body.Position = lockedPosition
        body.P = 100000
        body.Parent = root
    end
end

local function unlockPosition()
    local root = getRoot()

    if root then
        local existing = root:FindFirstChild("PositionLocker")
        if existing then
            existing:Destroy()
        end
    end

    lockedPosition = nil
end

task.spawn(function()
    while true do
        if Config.LockPosition then
            lockPosition()
        end
        task.wait(0.1)
    end
end)

Player.CharacterAdded:Connect(function(char)
    character = char

    local root = char:WaitForChild("HumanoidRootPart",5)

    if Config.LockPosition and root then
        lockedPosition = root.Position
        lockPosition()
    end
end)

